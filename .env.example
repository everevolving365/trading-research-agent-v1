# EverEvolving Trading Agent -- environment template
# Copy to .env and fill in ONLY the keys you want to use.
# BRING YOUR OWN KEY: this product ships with zero credentials.
# The agent runs its full backtest engine, compilers, walk-forward, Monte Carlo,
# lookahead detection and parity proof with NONE of these set (the zero-cost floor).

# ---------------------------------------------------------------- models -----
# Unlocks: conversation, interrogation engine, adversarial pass, code generation.
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Alternative model provider. Unlocks the same abilities.
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Alternative model provider. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------ data -----
# Unlocks: US stocks, ETFs, indices and forex minute history.
# Get it at: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=
# Unlocks: CME futures history including tick and order-flow data (paid, the most
# expensive data in the system). https://databento.com/portal/keys
DATABENTO_API_KEY=
# Unlocks: higher Binance rate limits. Public crypto klines need NO key.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ------------------------------------------------------------- tradingview ---
# Unlocks: the Operator -- Pine paste/save, Strategy Tester, Deep Backtesting,
# alert + webhook setup. Deep Backtesting requires a Premium plan.
# These are stored in the OS keychain by `ee-agent secrets set`; putting them here
# is supported but the keychain is preferred.
TRADINGVIEW_USERNAME=
TRADINGVIEW_PASSWORD=

# --------------------------------------------------------------- execution ---
# Unlocks: live trading on TopstepX.  https://api.topstepx.com
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
TOPSTEPX_ACCOUNT_ID=

# ----------------------------------------------------------------- agent ------
# Optional client-set spend ceiling in USD. Off by default. When reached the agent
# TELLS YOU AND ASKS -- it never silently stops.
EE_COST_CEILING_USD=
# Where artifacts, runs and the research index live.
EE_HOME=
