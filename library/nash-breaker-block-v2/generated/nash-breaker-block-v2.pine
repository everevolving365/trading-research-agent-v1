//@version=5
// NASH Breaker Block v2 -- signal indicator
// GENERATED from spec nash-breaker-block-v2 (sha256:f9c1c85613cd5ee9a6f477841d7edb9dbc1c8912367fca17b1ac227ddc0463b4)
// Compiled by ee_agent.compile.to_pine. Do not hand-edit: regenerate from the spec.
indicator("NASH Breaker Block v2", overlay=true, max_labels_count=500)

// ---- generated context -------------------------------------------------
// context fvg15: 15-minute fair value gaps, recorded when the 15-minute bar closes
[fvg15_h0, fvg15_l0, fvg15_h2, fvg15_l2, fvg15_bi] = request.security(syminfo.tickerid, "15", [high, low, high[2], low[2], bar_index], lookahead=barmerge.lookahead_off)
fvg15_new = ta.change(fvg15_bi) != 0
fvg15_bull = fvg15_new and fvg15_h2 < fvg15_l0
fvg15_bear = fvg15_new and fvg15_l2 > fvg15_h0
var fvg15_top = array.new_float()
var fvg15_bot = array.new_float()
var fvg15_dir = array.new_int()
var fvg15_bar = array.new_int()
var fvg15_mit = array.new_bool()
if fvg15_bull
    array.push(fvg15_top, fvg15_l0)
    array.push(fvg15_bot, fvg15_h2)
    array.push(fvg15_dir, 1)
    array.push(fvg15_bar, bar_index)
    array.push(fvg15_mit, false)
if fvg15_bear
    array.push(fvg15_top, fvg15_l2)
    array.push(fvg15_bot, fvg15_h0)
    array.push(fvg15_dir, -1)
    array.push(fvg15_bar, bar_index)
    array.push(fvg15_mit, false)
// mitigation: price trades into the gap (tracked while a gap can still be read: 60 bars)
if array.size(fvg15_top) > 0
    for j = array.size(fvg15_top) - 1 to 0
        if bar_index - array.get(fvg15_bar, j) > 60
            break
        if not array.get(fvg15_mit, j) and high >= array.get(fvg15_bot, j) and low <= array.get(fvg15_top, j)
            array.set(fvg15_mit, j, true)
// is there a qualifying gap on the fuel side of a broken level?
fvg15_fuel(isLong, lvl, maxDist, maxAge, matchDir, mustOpen) =>
    bool found = false
    int n = array.size(fvg15_top)
    if n > 0 and not na(lvl)
        for k = 0 to n - 1
            int j = n - 1 - k
            int b = array.get(fvg15_bar, j)
            if bar_index - b > maxAge
                break
            if b < bar_index
                float t = array.get(fvg15_top, j)
                float bt = array.get(fvg15_bot, j)
                int d = array.get(fvg15_dir, j)
                bool dirOk = not matchDir or (isLong ? d == 1 : d == -1)
                bool openOk = not mustOpen or not array.get(fvg15_mit, j)
                bool posOk = isLong ? (t <= lvl and lvl - t <= maxDist) : (bt >= lvl and bt - lvl <= maxDist)
                if dirOk and openOk and posOk
                    found := true
                    break
    found
// structure: latest confirmed pivot high (3 bars each side), burned once broken so it fires at most once
bos_hi_p3c_pv = ta.pivothigh(high, 3, 3)
var float bos_hi_p3c_lvl = na
var bool bos_hi_p3c_used = true
if not na(bos_hi_p3c_pv)
    bos_hi_p3c_lvl := bos_hi_p3c_pv
    bos_hi_p3c_used := close > bos_hi_p3c_pv
bos_hi_p3c_brk = not na(bos_hi_p3c_lvl) and not bos_hi_p3c_used and close > bos_hi_p3c_lvl
if bos_hi_p3c_brk
    bos_hi_p3c_used := true
// c_long_1: a fvg15 gap on the fuel side of bos_hi_p3c (max age 60 bars)
c_long_1_dist = 120.0
// structure: latest confirmed pivot low (3 bars each side), burned once broken so it fires at most once
bos_lo_p3c_pv = ta.pivotlow(low, 3, 3)
var float bos_lo_p3c_lvl = na
var bool bos_lo_p3c_used = true
if not na(bos_lo_p3c_pv)
    bos_lo_p3c_lvl := bos_lo_p3c_pv
    bos_lo_p3c_used := close < bos_lo_p3c_pv
bos_lo_p3c_brk = not na(bos_lo_p3c_lvl) and not bos_lo_p3c_used and close < bos_lo_p3c_lvl
if bos_lo_p3c_brk
    bos_lo_p3c_used := true
// c_short_1: a fvg15 gap on the fuel side of bos_lo_p3c (max age 60 bars)
c_short_1_dist = 120.0

// ---- filters ------------------------------------------------------------
inWindow = true

// ---- signals ------------------------------------------------------------
sig_long = (bos_hi_p3c_brk and (bos_hi_p3c_brk ? fvg15_fuel(true, bos_hi_p3c_lvl, c_long_1_dist, 60, true, false) : false)) and inWindow and barstate.isconfirmed
sig_short = (bos_lo_p3c_brk and (bos_lo_p3c_brk ? fvg15_fuel(false, bos_lo_p3c_lvl, c_short_1_dist, 60, true, false) : false)) and inWindow and barstate.isconfirmed
longSignal  = sig_long
shortSignal = sig_short

// ---- arrows -------------------------------------------------------------
plotshape(longSignal, title="Long", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="LONG")
plotshape(shortSignal, title="Short", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="SHORT")
plot(bos_hi_p3c_lvl, "structure high", color.new(color.aqua, 35), 1, plot.style_linebr)
plot(bos_lo_p3c_lvl, "structure low", color.new(color.aqua, 35), 1, plot.style_linebr)

// ---- alerts (ability 51: the indicator drives live execution) ------------
alertcondition(longSignal,  title="Long signal",  message="nash-breaker-block-v2 LONG {{ticker}} @ {{close}}")
alertcondition(shortSignal, title="Short signal", message="nash-breaker-block-v2 SHORT {{ticker}} @ {{close}}")
if longSignal
    alert("nash-breaker-block-v2 LONG " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar_close)
if shortSignal
    alert("nash-breaker-block-v2 SHORT " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar_close)
